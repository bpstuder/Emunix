#!/bin/bash
# Emunix: boot health. Every boot records an attempt in /var/lib/emunix/boot-attempts; a boot
# that reaches multi-user.target clears it again after a settle window. Two attempts in a row
# that never complete mean this slot does not boot, so the loader is pointed back at the other
# root slot and the failed one is marked bad.
#
#   emunix-health begin      record this boot attempt (run before anything can fail)
#   emunix-health check      exit 1 when the attempts say this slot does not boot
#   emunix-health clear      the boot completed; forget the attempts
#   emunix-health rollback   abandon this slot: clear the count, flip the loader, reboot
#
# Started by the emunix-boot-*.service units. Runs as root (/var, the ESP and systemctl are
# root-only). Every step also lands in /var/log/emunix-update.log, which survives a rollback.
set -euo pipefail

STATE_DIR=${EMUNIX_STATE_DIR:-/var/lib/emunix}
ATTEMPTS=$STATE_DIR/boot-attempts
LOG_FILE=${EMUNIX_UPDATE_LOG:-/var/log/emunix-update.log}
SLOT_BIN=${EMUNIX_SLOT_BIN:-/usr/local/bin/emunix-slot}
REBOOT_BIN=${EMUNIX_REBOOT:-/usr/bin/systemctl}
THRESHOLD=${EMUNIX_HEALTH_THRESHOLD:-2}

die() {
  printf 'emunix-health: %s\n' "$*" >&2
  printf '%s emunix-health: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG_FILE" 2>/dev/null || true
  exit 1
}

log() {
  printf '%s emunix-health: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG_FILE" 2>/dev/null || true
}

# A missing or unreadable counter counts as zero: the first boot of a device must not look like
# a repeated failure.
count() {
  local n
  n=$(cat "$ATTEMPTS" 2>/dev/null || true)
  case $n in
    ''|*[!0-9]*) printf '0\n' ;;
    *) printf '%s\n' "$n" ;;
  esac
}

# Every write is flushed: the counter exists to survive exactly the power-off it watches for, so
# a boot that loses power seconds after the increment must still be counted.
set_count() {
  printf '%s\n' "$1" >"$ATTEMPTS" || die "cannot write $ATTEMPTS"
  sync
}

begin() {
  local n
  mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
  n=$(($(count) + 1))
  set_count "$n"
  log "boot attempt $n of $THRESHOLD"
  printf 'boot attempt %s of %s\n' "$n" "$THRESHOLD"
}

check() {
  local n
  n=$(count)
  [ "$n" -ge "$THRESHOLD" ] || return 0
  log "attempt $n did not complete; rolling back to the previous slot"
  printf 'emunix-health: attempt %s did not complete; rolling back\n' "$n" >&2
  return 1
}

clear_attempts() {
  set_count 0
  log "boot completed; the attempt counter is clear"
  printf 'boot completed; attempt counter clear\n'
}

rollback() {
  local active previous
  # The count goes first, and it is flushed: a rollback must never cascade into another one on the
  # next boot, even if the reboot itself is not clean.
  set_count 0
  active=$("$SLOT_BIN" active) || die "cannot determine the running slot"
  case $active in
    a) previous=b ;;
    b) previous=a ;;
    *) die "the running slot '$active' is not a or b; refusing to guess the previous slot" ;;
  esac
  "$SLOT_BIN" next "$previous" || die "could not point the loader at slot $previous"
  "$SLOT_BIN" bad "$active" || die "could not mark slot $active bad"
  log "slot $active did not boot; default is emunix-$previous.conf and slot $active is marked bad"
  printf 'emunix-health: slot %s did not boot; the loader now defaults to slot %s\n' "$active" "$previous"
  log "requesting the reboot"
  # --no-block: the unit must exit before the shutdown it asked for, or systemd records the
  # reboot's own process teardown as a failure and runs the rescue path.
  if ! "$REBOOT_BIN" --no-block reboot; then
    die "could not request the reboot"
  fi
  log "reboot requested"
}

[ $# -ge 1 ] || die "usage: emunix-health begin | check | clear | rollback"
cmd=$1
shift
case $cmd in
  begin) [ $# -eq 0 ] || die "usage: emunix-health begin"; begin ;;
  check) [ $# -eq 0 ] || die "usage: emunix-health check"; check ;;
  clear) [ $# -eq 0 ] || die "usage: emunix-health clear"; clear_attempts ;;
  rollback) [ $# -eq 0 ] || die "usage: emunix-health rollback"; rollback ;;
  *) die "usage: emunix-health begin | check | clear | rollback" ;;
esac
