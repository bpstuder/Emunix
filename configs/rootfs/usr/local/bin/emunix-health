#!/bin/bash
# Emunix: boot health. Every boot opens an attempt; a boot that reaches multi-user.target is
# remembered as having booted, and a boot that stays up clears the count after a settle window.
# Boots that never reach multi-user are counted, and at the second one in a row the loader is
# pointed back at the other root slot and the failed one is marked bad.
#
#   emunix-health begin      open this boot's attempt (run before anything can fail)
#   emunix-health check      exit 1 when the attempts say this slot does not boot
#   emunix-health reached    multi-user.target is up: this boot did boot
#   emunix-health clear      the boot stayed up; forget the attempts
#   emunix-health rollback   abandon this slot: clear the count, flip the loader, reboot
#
# The "reached" marker is what tells "the user powered off during boot" from "this slot does not
# boot": a boot that got as far as multi-user.target counts as booted even if it was switched off
# a moment later, so it does not put the next boot at risk of a rollback. The settle window before
# the clear is the same distinction seen from the other side -- a boot that only reached
# multi-user for a moment has not shown it can stay up.
#
# Started by the emunix-boot-*.service units. Runs as root (/var, the ESP and systemctl are
# root-only). Every step also lands in /var/log/emunix-update.log, which survives a rollback.
set -euo pipefail

STATE_DIR=${EMUNIX_STATE_DIR:-/var/lib/emunix}
ATTEMPTS=$STATE_DIR/boot-attempts
REACHED=$STATE_DIR/reached
LOG_FILE=${EMUNIX_UPDATE_LOG:-/var/log/emunix-update.log}
SLOT_BIN=${EMUNIX_SLOT_BIN:-/usr/local/bin/emunix-slot}
REBOOT_BIN=${EMUNIX_REBOOT:-/usr/bin/systemctl}
THRESHOLD=${EMUNIX_HEALTH_THRESHOLD:-2}

die() {
  printf 'emunix-health: %s\n' "$*" >&2
  printf '%s emunix-health: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG_FILE" 2>/dev/null || true
  exit 1
}

log() {
  printf '%s emunix-health: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG_FILE" 2>/dev/null || true
}

# Both files are written together and flushed: the counter exists to survive exactly the
# power-off it watches for, so a boot that loses power seconds after the write must still count.
store() { # <boot-attempts> <reached>
  printf '%s\n' "$1" >"$ATTEMPTS" || die "cannot write $ATTEMPTS"
  printf '%s\n' "$2" >"$REACHED" || die "cannot write $REACHED"
  sync
}

read_attempts() {
  local n
  n=$(cat "$ATTEMPTS" 2>/dev/null || true)
  case $n in
    ''|*[!0-9]*) printf '0\n' ;;
    *) printf '%s\n' "$n" ;;
  esac
}

begin() {
  local reached attempts
  mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
  reached=$(cat "$REACHED" 2>/dev/null || true)
  attempts=$(read_attempts)
  if [ "${reached:-0}" = 1 ]; then
    # The previous boot reached multi-user: it booted, whatever happened after that, so this
    # boot starts a fresh count instead of inheriting the old one.
    attempts=1
  else
    attempts=$((attempts + 1))
  fi
  store "$attempts" 0
  log "boot attempt $attempts of $THRESHOLD"
  printf 'boot attempt %s of %s\n' "$attempts" "$THRESHOLD"
}

check() {
  local n
  n=$(read_attempts)
  [ "$n" -ge "$THRESHOLD" ] || return 0
  log "attempt $n did not reach multi-user; rolling back to the previous slot"
  printf 'emunix-health: attempt %s did not reach multi-user; rolling back\n' "$n" >&2
  return 1
}

reached() {
  store "$(read_attempts)" 1
  log "multi-user.target reached"
  printf 'multi-user.target reached\n'
}

clear_attempts() {
  store 0 0
  log "boot completed; the attempt counter is clear"
  printf 'boot completed; attempt counter clear\n'
}

rollback() {
  local active previous
  # A rollback must never cascade into another one on the next boot, even if the reboot itself
  # is not clean.
  store 0 0
  active=$("$SLOT_BIN" active) || die "cannot determine the running slot"
  case $active in
    a) previous=b ;;
    b) previous=a ;;
    *) die "the running slot '$active' is not a or b; refusing to guess the previous slot" ;;
  esac
  "$SLOT_BIN" next "$previous" || die "could not point the loader at slot $previous"
  "$SLOT_BIN" bad "$active" || die "could not mark slot $active bad"
  log "slot $active did not boot; default is emunix-$previous.conf and slot $active is marked bad"
  printf 'emunix-health: slot %s did not boot; the loader now defaults to slot %s\n' "$active" "$previous"
  log "requesting the reboot"
  # --no-block: the unit must exit before the shutdown it asked for, or systemd records the
  # reboot's own process teardown as a failure and runs the rescue path.
  if ! "$REBOOT_BIN" --no-block reboot; then
    die "could not request the reboot"
  fi
  log "reboot requested"
}

[ $# -ge 1 ] || die "usage: emunix-health begin | check | reached | clear | rollback"
cmd=$1
shift
case $cmd in
  begin) [ $# -eq 0 ] || die "usage: emunix-health begin"; begin ;;
  check) [ $# -eq 0 ] || die "usage: emunix-health check"; check ;;
  reached) [ $# -eq 0 ] || die "usage: emunix-health reached"; reached ;;
  clear) [ $# -eq 0 ] || die "usage: emunix-health clear"; clear_attempts ;;
  rollback) [ $# -eq 0 ] || die "usage: emunix-health rollback"; rollback ;;
  *) die "usage: emunix-health begin | check | reached | clear | rollback" ;;
esac
