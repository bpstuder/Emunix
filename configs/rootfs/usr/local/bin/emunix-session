#!/bin/bash
# The Emunix session: ES-DE on the current VT, wrapped in gamescope. Started on tty1 by
# ~/.bash_profile through the emunix-session user unit; its output goes to the user journal.
set -uo pipefail

# ES-DE 3.x keeps its configuration in ~/ES-DE (settings/, custom_systems/). The installed seed is
# read-only, so it is copied once: later user edits then survive image updates.
if [ ! -d "$HOME/ES-DE" ]; then
  mkdir -p "$HOME/ES-DE/settings" "$HOME/ES-DE/custom_systems"
  cp /etc/emulationstation/es_settings.xml "$HOME/ES-DE/settings/"
  cp /etc/emulationstation/es_systems.xml "$HOME/ES-DE/custom_systems/"
fi

# Player 1 is the pad used last: SDL enumerates joysticks in SDL_JOYSTICK_DEVICE
# order, and emunix-pad-order lists the most recently connected pad first.
if order=$(/usr/local/bin/emunix-pad-order); then
  export SDL_JOYSTICK_DEVICE="$order"
fi

status=0

# The same line on the VT and in the user journal: while gamescope starts, the VT is all the user
# sees, so a black screen there must at least say what was tried.
# shortcut: best effort. If the DRM driver is dead the VT shows nothing - that is the GPU's failure
# (t_186b10eb), not something this wrapper can draw around.
say() {
  printf 'emunix-session: %s\n' "$*"
  printf 'emunix-session: %s\n' "$*" >>"${EMUNIX_SESSION_TTY:-/dev/tty1}" 2>/dev/null || true
}

say "starting the frontend under gamescope"
gamescope -f -- es-de || status=$?
if [ "$status" -ne 0 ]; then
  # gamescope needs a compositor-capable GPU; ES-DE's own KMSDRM output only needs KMS + GL.
  # shortcut: one retry without gamescope, no loop; revisit if a device needs gamescope only.
  say "gamescope exited $status, starting es-de directly"
  status=0
  es-de || status=$?
fi
printf 'emunix-session: exiting %s\n' "$status"
exit "$status"
