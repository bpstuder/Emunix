#!/bin/bash
# Emunix first boot: grow the last partition into the rest of the device and seed the /storage
# tree. Run once by firstboot.service before the frontend starts; the marker is written last, so an
# interrupted first boot simply runs again.
#
# The shipped retrogamer:retrogamer password is left alone. /etc survives an image update, so the
# user changes it with `passwd` when they want to; INSTALL.md carries the warning that it is
# public until then.
set -uo pipefail

USER_NAME=retrogamer
# PREFIX is empty in the image; tests/test-firstboot.sh points it at a sandbox root. /var is a
# partition of its own and persists across updates, so the marker survives an image update.
PREFIX=${EMUNIX_FIRSTBOOT_PREFIX:-}
MARKER=$PREFIX/var/lib/emunix/initialized
STORAGE=$PREFIX/storage
SYSTEMS=$PREFIX/etc/emulationstation/es_systems.xml

log() { printf 'emunix-firstboot: %s\n' "$*"; }
fail() { log "$*"; exit 1; }

# Who is doing what, on the handheld's screen and in the journal. /dev/tty1 is the VT; stdout is the
# journal, which firstboot.service also copies to the console - and the kernel cmdline ends in
# console=ttyS0, so /dev/console is the serial port and a stdout line never lights the VT.
# shortcut: best effort, no retry, no redraw. If the DRM driver dies and takes the framebuffer with
# it, nothing written to tty1 is visible; that is the GPU's failure (t_186b10eb) and no console
# output can draw around it.
progress() {
  local line="Emunix first boot: $*"
  printf '%s\n' "$line"
  printf '%s\n' "$line" >>"${EMUNIX_FIRSTBOOT_TTY:-/dev/tty1}" 2>/dev/null || true
}

# 1. The image is built at a fixed size and flashed onto something bigger: extend the last
# partition (home, which carries /storage) to the end of the device and hand the space to btrfs.
grow_disk() {
  local part disk num rc
  part=$(findmnt -no SOURCE "$STORAGE") || fail "no /storage mount"
  # A btrfs subvolume mount reports "/dev/vda5[/storage]"; growpart wants the disk and a number.
  part=${part%%\[*}
  disk=$(lsblk -no pkname "$part")
  num=$(lsblk -no partn "$part")
  if [ -z "$disk" ] || [ -z "$num" ]; then
    fail "cannot work out the disk behind $part"
  fi
  progress "growing the disk to $(lsblk -no SIZE "/dev/$disk")..."
  growpart "/dev/$disk" "$num"
  rc=$?
  # growpart: 0 = changed, 1 = NOCHANGE (already fills the device), anything else is an error.
  case "$rc" in
    0) log "grew $part into the free space" ;;
    1) log "$part already fills the device" ;;
    *) fail "growpart /dev/$disk $num failed (rc=$rc)" ;;
  esac
  btrfs filesystem resize max "$STORAGE" || fail "btrfs filesystem resize max $STORAGE failed"
}

# 2. The ROM tree the frontend scans: ES-DE only lists a system whose %ROMPATH% directory exists,
# and es_systems.xml is the single list of the systems this image ships.
seed_storage() {
  local sys
  progress "seeding /storage..."
  mkdir -p "$STORAGE/roms" "$STORAGE/bios" "$STORAGE/saves" "$STORAGE/states" ||
    fail "cannot create the /storage tree"
  while read -r sys; do
    [ -n "$sys" ] || continue
    mkdir -p "$STORAGE/roms/$sys" || fail "cannot create $STORAGE/roms/$sys"
  done < <(sed -n 's|.*<path>%ROMPATH%/\([^<]*\)</path>.*|\1|p' "$SYSTEMS")
  # The Power Profiles menu (configs/rootfs/usr/share/emunix/power-profiles) is seeded into
  # the scanned folder so ES-DE lists the three switches; the copies live on /storage, so a
  # user can edit them.
  for script in "$PREFIX/usr/share/emunix/power-profiles"/*.sh; do
    install -D -m 0755 "$script" "$STORAGE/roms/power/$(basename "$script")" ||
      fail "cannot seed $script"
  done
  # Same for the install entry: the script prints the plan, and the console does the install.
  if [ -d "$PREFIX/usr/share/emunix/install" ]; then
    for script in "$PREFIX/usr/share/emunix/install"/*.sh; do
      install -D -m 0755 "$script" "$STORAGE/roms/install/$(basename "$script")" ||
        fail "cannot seed $script"
    done
  fi
  # The session runs as retrogamer: without this it cannot save a state or add a ROM.
  chown -R "$USER_NAME:$USER_NAME" "$STORAGE" || fail "cannot chown $STORAGE"
}

grow_disk
seed_storage

# 3. Last: an interrupted first boot must retry everything above.
mkdir -p "$(dirname "$MARKER")" || fail "cannot create $(dirname "$MARKER")"
: >"$MARKER" || fail "cannot write $MARKER"
log "first boot complete"
progress "done, starting the frontend"
