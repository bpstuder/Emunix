#!/bin/bash
# Emunix: give /etc a writable overlay on the read-only root. NetworkManager profiles, the
# hostname and anything else that seeds config at runtime then work and survive a reboot.
#
# The upper and work directories live on /var for the whole device, not per root slot: an image
# update rewrites the other slot, and a slot-keyed layer would start from that image's /etc every
# time, resetting the Wi-Fi profiles, the hostname, the users and their passwords. A file the user
# never wrote is not in the upper, so it still follows the new image.
# Started by emunix-etc-overlay.service. Exits non-zero rather than leaving /etc writable in a
# place the next image does not expect.
set -euo pipefail

if [ "$(findmnt -no FSTYPE /etc 2>/dev/null || true)" = overlay ]; then
  exit 0
fi

dir=/var/lib/emunix/etc
mkdir -p "$dir/upper" "$dir/work"

# The work directory is copy-up scratch: leftovers from an earlier image generation are not worth
# reusing.
find "$dir/work" -mindepth 1 -delete
# Generated by the previous image, not settings: a stale copy must never shadow the new one.
rm -f "$dir/upper/ld.so.cache" "$dir/upper/.updated" "$dir/upper/machine-id"

# index=off: with the index on, overlayfs records which lower file every upper entry came from and
# refuses to mount once that lower is gone - which is what an image update makes of a slot. Without
# it the upper is plain content that outlives the image it was written under.
mount -t overlay overlay \
  -o "lowerdir=/etc,upperdir=$dir/upper,workdir=$dir/work,index=off" /etc
