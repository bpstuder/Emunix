[Unit]
Description=Emunix first boot (grow the disk, seed /storage)
ConditionPathExists=!/var/lib/emunix/initialized
After=local-fs.target
# The frontend must not scan /storage before it is seeded.
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/emunix-firstboot
# Also on the kernel console: a headless flash shows the progress on the serial port.
StandardOutput=journal+console
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
