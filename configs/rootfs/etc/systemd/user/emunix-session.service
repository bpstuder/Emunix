[Unit]
Description=Emunix games session (EmulationStation-DE)

[Service]
Type=simple
ExecStart=/usr/local/bin/emunix-session
# One controller mapping set for the frontend and every standalone emulator:
# SDL reads this file (SDL_GAMECONTROLLERCONFIG_FILE) and its user entries
# override the database compiled into SDL. HIDAPI stays on, which is what the
# PS4/PS5, Switch and Xbox One S/Series pads need; see README.md.
Environment=SDL_GAMECONTROLLERCONFIG_FILE=/usr/share/emunix/gamecontrollerdb.txt
Environment=SDL_JOYSTICK_HIDAPI=1
# No restart: a loop would flash between the frontend and a black screen. The login shell on tty1
# prints the journal hint instead.
Restart=no
