        <command>/usr/bin/retroarch -L /usr/lib/libretro/flycast_libretro.so %ROM%</command>
        <platform>dreamcast</platform>
        <theme>dreamcast</theme>
    </system>
    <system>
        <name>gc</name>
        <fullname>Nintendo GameCube</fullname>
        <path>%ROMPATH%/gc</path>
        <extension>.iso .ISO .rvz .RVZ .gcm .GCM .gcz .GCZ .wia .WIA .dol .DOL .elf .ELF</extension>
        <command>/usr/bin/dolphin-emu -b -e %ROM%</command>
        <platform>gc</platform>
        <theme>gc</theme>
    </system>
    <system>
        <name>wii</name>
        <fullname>Nintendo Wii</fullname>
        <path>%ROMPATH%/wii</path>
        <extension>.iso .ISO .rvz .RVZ .wbfs .WBFS .gcm .GCM .gcz .GCZ .wia .WIA</extension>
        <command>/usr/bin/dolphin-emu -b -e %ROM%</command>
        <platform>wii</platform>
        <theme>wii</theme>
    </system>
    <system>
        <name>psp</name>
        <fullname>Sony PSP</fullname>
        <path>%ROMPATH%/psp</path>
        <extension>.iso .ISO .cso .CSO .chd .CHD .pbp .PBP</extension>
        <command>/usr/bin/PPSSPPSDL %ROM%</command>
        <platform>psp</platform>
        <theme>psp</theme>
    </system>
</systemList>
